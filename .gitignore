TODO.md

# API keys: .env is read by config.load_env(). .env.example is tracked and holds
# names only, never values.
.env
.env.*
!.env.example

# data/ holds datasets only; the scripts that build and audit them stay local
data/**/*.py

data/role_play/instructions
data/role_play/role_list*
data/role_play/extraction_questions.jsonl
data/role_play/roles.jsonl

# jailbreaks: downloads and labelling chunks regenerate from download_sources.py and
# classify_itw.py; the labels_*.jsonl the LLM wrote do not, so those stay tracked
data/jailbreaks/raw
data/jailbreaks/classification/*chunk_*.md
data/jailbreaks/classification/itw_unique.jsonl
data/jailbreaks/classification

round1

audit

# experiments: results/<tag>/<model>/{csv,vectors,acts,meta}
# csv/ and meta/ stay tracked; the cache and vectors regenerate from the cache in seconds
# (lopo_d alone is ~20 MB per direction at d=3584).
experiments/*/results/*/*/acts/
experiments/*/results/*/*/vectors/
experiments/*/results/*/*/meta/_archive/